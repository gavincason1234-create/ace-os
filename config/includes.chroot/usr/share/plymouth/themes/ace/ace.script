# ACE OS boot splash: still background, pulsing sigil, red progress bar.

background = Image("background.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
scaled = background.Scale(screen_width, screen_height);
background_sprite = Sprite(scaled);
background_sprite.SetZ(-100);

logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(screen_width / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(screen_height * 0.34 - logo.GetHeight() / 2);
logo_sprite.SetOpacity(0);

progress = 0;
pulse = 0;

fun refresh_callback() {
    pulse = pulse + 0.06;
    opacity = 0.65 + 0.35 * Math.Sin(pulse);
    logo_sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);

# thin red bar that fills as the boot proceeds
bar_width = Math.Int(screen_width * 0.24);
bar_x = Math.Int(screen_width / 2 - bar_width / 2);
bar_y = Math.Int(screen_height * 0.62);
bar_image = Image.Text("", 1, 1, 1);

fun draw_progress(fraction) {
    filled = Math.Int(bar_width * fraction);
    if (filled < 1) { filled = 1; }
    bar = Image.Text(" ", 0, 0, 0);
    progress_sprite = Sprite();
    progress_sprite.SetImage(bar_image.Scale(filled, 2));
    progress_sprite.SetX(bar_x);
    progress_sprite.SetY(bar_y);
    progress_sprite.SetZ(10);
}

fun boot_progress_callback(duration, fraction) {
    progress = fraction;
}
Plymouth.SetBootProgressCallback(boot_progress_callback);

fun display_password_callback(prompt, bullets) {
    logo_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun quit_callback() {
    logo_sprite.SetOpacity(0);
    background_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
