#!/usr/bin/env python3
"""ace-fetch — system summary in ACE colours (a neofetch for this machine)."""

import os
import re
import shutil
import sys
from pathlib import Path

RED = "\033[38;5;196m"
DRED = "\033[38;5;88m"
WHITE = "\033[38;5;255m"
GREY = "\033[38;5;245m"
R = "\033[0m"

LOGO = [
    f"{DRED}      ▄▄▄       ▄████▄  ▓█████ {R}",
    f"{DRED}     ▒████▄    ▒██▀ ▀█  ▓█   ▀ {R}",
    f"{RED}     ▒██  ▀█▄  ▒▓█    ▄ ▒███   {R}",
    f"{RED}     ░██▄▄▄▄██ ▒▓▓▄ ▄██▒▒▓█  ▄ {R}",
    f"{RED}      ▓█   ▓██▒▒ ▓███▀ ░░▒████▒{R}",
    f"{DRED}      ▒▒   ▓▒█░░ ░▒ ▒  ░░░ ▒░ ░{R}",
    f"{DRED}       ▒   ▒▒ ░  ░  ▒     ░ ░  {R}",
]


def read(path):
    try:
        return Path(path).read_text()
    except Exception:
        return ""


def human(size):
    return f"{size / 1e9:.1f}G" if size >= 1e9 else f"{size / 1e6:.0f}M"


def facts():
    out = []
    user = os.environ.get("USER") or "ace"
    host = read("/etc/hostname").strip() or "aceos"
    out.append((None, f"{RED}{user}{GREY}@{RED}{host}{R}"))
    out.append((None, f"{DRED}{'─' * (len(user) + len(host) + 1)}{R}"))

    pretty = ""
    match = re.search(r'PRETTY_NAME="?([^"\n]+)', read("/etc/os-release"))
    if match:
        pretty = match.group(1)
    out.append(("os", pretty or "ACE OS"))

    kernel = os.uname().release
    out.append(("kernel", kernel))

    uptime = read("/proc/uptime").split()
    if uptime:
        secs = int(float(uptime[0]))
        out.append(("uptime", f"{secs // 3600}h {(secs % 3600) // 60}m"))

    cpu = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    if cpu:
        out.append(("cpu", f"{cpu} ({os.cpu_count()}x)"))

    total = avail = 0
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            total = int(line.split()[1]) * 1024
        elif line.startswith("MemAvailable:"):
            avail = int(line.split()[1]) * 1024
    if total:
        out.append(("memory", f"{human(total - avail)} / {human(total)}"))

    try:
        usage = shutil.disk_usage("/")
        out.append(("disk", f"{human(usage.used)} / {human(usage.total)} "
                            f"({human(usage.free)} free)"))
    except Exception:
        pass

    brain = "not installed  (run: ace --setup)"
    for directory in (Path("/usr/share/ace/models"),
                      Path.home() / ".local/share/ace/models"):
        if directory.is_dir():
            models = sorted(directory.glob("*.gguf"))
            if models:
                brain = f"{models[0].stem}  ({human(models[0].stat().st_size)})"
                break
    out.append(("ai brain", brain))
    return out


def main():
    rows = facts()
    width = max((len(k) for k, _ in rows if k), default=8)
    lines = []
    for key, value in rows:
        lines.append(value if key is None
                     else f"{WHITE}{key:<{width}}{R} {DRED}│{R} {GREY}{value}{R}")

    height = max(len(LOGO), len(lines))
    for index in range(height):
        left = LOGO[index] if index < len(LOGO) else " " * 31
        right = lines[index] if index < len(lines) else ""
        print(f"{left}  {right}")
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
