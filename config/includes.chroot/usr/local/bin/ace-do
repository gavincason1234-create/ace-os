#!/usr/bin/env python3
"""ace-do — ask ACE to work the machine for you.

  ace-do "free up some disk space"
  ace-do "show me the biggest files in my home folder"
  ace-do --write "a python script that renames photos by date" > rename.py

ACE proposes a shell command, explains it in one line, and shows it to you.
Nothing runs until you say yes. Commands that would destroy data are refused
outright rather than offered — this is an assistant, not an autopilot.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

RED = "\033[38;5;196m"
DRED = "\033[38;5;88m"
GREY = "\033[38;5;245m"
WHITE = "\033[38;5;255m"
GREEN = "\033[38;5;46m"
YELL = "\033[38;5;220m"
R = "\033[0m"

ACE = "/usr/local/bin/ace"

# Patterns that are never offered, however they are phrased.
FORBIDDEN = [
    (r"\brm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*[rf][a-zA-Z]*\s+/(\s|$)", "deletes the whole system"),
    (r"\brm\s+-[a-zA-Z]*r[a-zA-Z]*f|\brm\s+-[a-zA-Z]*f[a-zA-Z]*r", "recursive force delete"),
    (r"\bmkfs(\.|\s)", "formats a drive"),
    (r"\bdd\b.*\bof=/dev/", "overwrites a raw disk"),
    (r">\s*/dev/[sh]d[a-z]", "overwrites a raw disk"),
    (r"\bfdisk\b|\bparted\b.*\b(mklabel|rm)\b", "rewrites the partition table"),
    (r":\(\)\s*\{.*\};\s*:", "fork bomb"),
    (r"\bchmod\s+-R\s+777\s+/(\s|$)", "strips permissions system-wide"),
    (r"\b(shutdown|reboot|halt|poweroff)\b", "shuts the machine down"),
    (r"\bcurl\b[^|]*\|\s*(sudo\s+)?(ba)?sh", "pipes an unseen script into a shell"),
    (r"\bwget\b[^|]*\|\s*(sudo\s+)?(ba)?sh", "pipes an unseen script into a shell"),
    (r"\buserdel\b|\bpasswd\b\s+root", "changes account access"),
]

SYSTEM_PROMPT_CMD = (
    "You translate a request into ONE shell command for Debian Linux with "
    "bash. Reply in exactly two lines and nothing else:\n"
    "CMD: <the command>\n"
    "WHY: <one short sentence explaining it>\n"
    "Rules: prefer read-only commands; never delete, format or reboot; do not "
    "use sudo unless truly required; no placeholders — the command must run "
    "as written."
)

SYSTEM_PROMPT_CODE = (
    "You write a complete, runnable file. Output ONLY the code, with no "
    "markdown fences and no commentary before or after."
)


def ask_ace(question, system):
    """Run the local model with a task-specific system prompt."""
    if not Path(ACE).exists():
        print(f"{RED}!{R} the local AI is not installed", file=sys.stderr)
        return None
    env = dict(os.environ, ACE_SYSTEM_PROMPT=system)
    result = subprocess.run([ACE, question], capture_output=True, text=True,
                            env=env, timeout=600)
    return (result.stdout or "").strip()


def unsafe_reason(command):
    for pattern, reason in FORBIDDEN:
        if re.search(pattern, command, re.I):
            return reason
    return None


def parse_reply(reply):
    command = why = ""
    for line in (reply or "").splitlines():
        line = line.strip()
        if line.upper().startswith("CMD:"):
            command = line[4:].strip().strip("`")
        elif line.upper().startswith("WHY:"):
            why = line[4:].strip()
    if not command:
        # Model ignored the format: take the first plausible command line.
        for line in (reply or "").splitlines():
            line = line.strip().strip("`")
            if line and not line.endswith(":") and " " in line:
                command = line
                break
    return command, why


def do_command(request, auto_yes):
    print(f"{GREY}thinking…{R}", end="\r", flush=True)
    reply = ask_ace(request, SYSTEM_PROMPT_CMD)
    sys.stdout.write("          \r")
    if not reply:
        return 1

    command, why = parse_reply(reply)
    if not command:
        print(f"{RED}!{R} ACE did not produce a command. It said:\n{reply}")
        return 1

    reason = unsafe_reason(command)
    print(f"\n{DRED}┌─{R} {WHITE}proposed{R}")
    print(f"{DRED}│{R}  {RED}{command}{R}")
    if why:
        print(f"{DRED}│{R}  {GREY}{why}{R}")
    print(f"{DRED}└─{R}")

    if reason:
        print(f"\n{RED}✗ refused{R} — that command {reason}.")
        print(f"{GREY}ACE will not run this. Do it yourself if you truly mean it.{R}\n")
        return 1

    if auto_yes:
        answer = "y"
    else:
        try:
            answer = input(f"{DRED}└─{RED}▶{R} run it? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
    if answer not in ("y", "yes"):
        print(f"{GREY}not run.{R}\n")
        return 0

    print(f"{DRED}{'─' * 60}{R}")
    result = subprocess.run(["bash", "-c", command])
    print(f"{DRED}{'─' * 60}{R}")
    status = (f"{GREEN}✓ finished{R}" if result.returncode == 0
              else f"{YELL}! exit code {result.returncode}{R}")
    print(f"{status}\n")
    return result.returncode


def do_code(request, out):
    print(f"{GREY}writing…{R}", end="\r", flush=True)
    code = ask_ace(request, SYSTEM_PROMPT_CODE)
    sys.stdout.write("         \r")
    if not code:
        return 1
    # Strip fences if the model added them anyway.
    code = re.sub(r"^```[a-zA-Z]*\n|\n```$", "", code.strip())
    if out:
        path = Path(out).expanduser()
        path.write_text(code + "\n")
        print(f"{GREEN}✓{R} wrote {WHITE}{path}{R} {GREY}({len(code.splitlines())} lines){R}")
    else:
        print(code)
    return 0


def main():
    parser = argparse.ArgumentParser(prog="ace-do", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("request", nargs="+", help="what you want done")
    parser.add_argument("--write", action="store_true",
                        help="write code instead of running a command")
    parser.add_argument("-o", "--out", help="save written code to this file")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="skip the confirmation (still refuses unsafe commands)")
    args = parser.parse_args()

    request = " ".join(args.request)
    if args.write or args.out:
        return do_code(request, args.out)
    return do_command(request, args.yes)


if __name__ == "__main__":
    sys.exit(main())
