#!/usr/bin/env python3
"""ace-rain — the ACE digit rain: live wallpaper, screensaver, or terminal toy.

  ace-rain --wallpaper     animate behind the desktop (sits below your windows)
  ace-rain --screensaver   fullscreen; any key or mouse move exits
  ace-rain --window        run in a normal window
  ace-rain --tty           plain terminal mode, needs nothing installed

Columns fall as the countdown 09 08 07 ... 01, brightest at the head. Tuned
for a slow CPU: modest frame rate, no compositing, no GPU required.
"""

import argparse
import os
import random
import shutil
import signal
import sys
import time

DIGITS = "090807060504030201"


# --------------------------------------------------------------- simulation

class Rain:
    """Column state shared by every renderer."""

    def __init__(self, columns, rows, density=0.75):
        self.columns = max(1, columns)
        self.rows = max(1, rows)
        self.drops = []
        for x in range(self.columns):
            if random.random() < density:
                self.drops.append({
                    "x": x,
                    "y": random.uniform(-rows, 0),
                    "speed": random.uniform(0.35, 1.25),
                    "length": random.randint(max(4, rows // 6), max(6, rows // 2)),
                    "tick": random.randrange(len(DIGITS)),
                })

    def step(self):
        for drop in self.drops:
            drop["y"] += drop["speed"]
            if drop["y"] - drop["length"] > self.rows:
                drop["y"] = random.uniform(-self.rows / 2, 0)
                drop["speed"] = random.uniform(0.35, 1.25)
                drop["length"] = random.randint(max(4, self.rows // 6),
                                                max(6, self.rows // 2))

    def cells(self):
        """Yield (x, y, char, intensity) for everything currently lit."""
        for drop in self.drops:
            head = int(drop["y"])
            for offset in range(drop["length"]):
                y = head - offset
                if 0 <= y < self.rows:
                    intensity = 1.0 - (offset / drop["length"])
                    char = DIGITS[(drop["tick"] + y) % len(DIGITS)]
                    yield drop["x"], y, char, intensity


# ------------------------------------------------------------------ curses

def run_tty(fps=14):
    size = shutil.get_terminal_size((80, 24))
    rain = Rain(size.columns, size.lines - 1)
    sys.stdout.write("\033[?25l\033[2J")
    try:
        while True:
            frame = ["\033[H"]
            grid = {}
            for x, y, char, intensity in rain.cells():
                grid[(x, y)] = (char, intensity)
            for y in range(rain.rows):
                line = []
                for x in range(rain.columns):
                    cell = grid.get((x, y))
                    if not cell:
                        line.append(" ")
                        continue
                    char, intensity = cell
                    if intensity > 0.92:
                        line.append(f"\033[97m{char}")
                    elif intensity > 0.6:
                        line.append(f"\033[38;5;196m{char}")
                    elif intensity > 0.3:
                        line.append(f"\033[38;5;160m{char}")
                    else:
                        line.append(f"\033[38;5;88m{char}")
                frame.append("".join(line) + "\033[0m\n")
            sys.stdout.write("".join(frame))
            sys.stdout.flush()
            rain.step()
            time.sleep(1 / fps)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[0m\033[?25h\033[2J\033[H")
        sys.stdout.flush()


# --------------------------------------------------------------------- gtk

def run_gtk(mode, fps, cell, ring):
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gtk, Gdk, GLib
        import cairo
    except Exception as err:
        print(f"ace-rain: graphical mode unavailable ({err})", file=sys.stderr)
        print("falling back to terminal mode — press Ctrl-C to stop.", file=sys.stderr)
        time.sleep(1.5)
        return run_tty(fps)

    window = Gtk.Window()
    window.set_app_paintable(True)
    window.set_decorated(False)
    screen = window.get_screen()
    width = screen.get_width()
    height = screen.get_height()
    window.set_default_size(width, height)
    window.move(0, 0)

    if mode == "wallpaper":
        window.set_type_hint(Gdk.WindowTypeHint.DESKTOP)
        window.set_keep_below(True)
        window.stick()
    elif mode == "screensaver":
        window.set_type_hint(Gdk.WindowTypeHint.NORMAL)
        window.fullscreen()
        window.set_keep_above(True)
    window.set_skip_taskbar_hint(mode != "window")
    window.set_skip_pager_hint(mode != "window")

    state = {"rain": Rain(max(1, width // cell), max(1, height // cell)),
             "hue": 0.0}

    def hue_rgb(hue):
        import colorsys
        return colorsys.hsv_to_rgb(hue % 1.0, 0.95, 1.0)

    def on_draw(_widget, ctx):
        ctx.set_source_rgb(0.039, 0.008, 0.012)
        ctx.paint()
        ctx.select_font_face("DejaVu Sans Mono", cairo.FONT_SLANT_NORMAL,
                             cairo.FONT_WEIGHT_NORMAL)
        ctx.set_font_size(cell * 0.95)
        for x, y, char, intensity in state["rain"].cells():
            if intensity > 0.93:
                ctx.set_source_rgb(1, 1, 1)
            else:
                ctx.set_source_rgb(0.88 * intensity + 0.05,
                                   0.06 * intensity,
                                   0.16 * intensity)
            ctx.move_to(x * cell, (y + 1) * cell)
            ctx.show_text(char)
        if ring:
            red, green, blue = hue_rgb(state["hue"])
            ctx.set_source_rgb(red, green, blue)
            ctx.set_line_width(ring * 2)
            ctx.rectangle(0, 0, width, height)
            ctx.stroke()
        return False

    def tick():
        state["rain"].step()
        state["hue"] += 0.004
        window.queue_draw()
        return True

    window.connect("draw", on_draw)
    window.connect("destroy", Gtk.main_quit)

    if mode == "screensaver":
        window.add_events(Gdk.EventMask.KEY_PRESS_MASK
                          | Gdk.EventMask.POINTER_MOTION_MASK
                          | Gdk.EventMask.BUTTON_PRESS_MASK)
        start = time.monotonic()

        def wake(*_args):
            # ignore the pointer settling right after launch
            if time.monotonic() - start > 1.0:
                Gtk.main_quit()
            return True

        for event in ("key-press-event", "motion-notify-event", "button-press-event"):
            window.connect(event, wake)
    elif mode == "wallpaper":
        # Let every click fall through to the desktop underneath.
        window.connect("realize", lambda w: w.get_window().set_pass_through(True)
                       if hasattr(w.get_window(), "set_pass_through") else None)

    GLib.timeout_add(int(1000 / fps), tick)
    window.show_all()
    if mode == "wallpaper":
        try:
            window.get_window().set_pass_through(True)
        except Exception:
            pass
    Gtk.main()
    return 0


def main():
    signal.signal(signal.SIGINT, signal.default_int_handler)
    parser = argparse.ArgumentParser(prog="ace-rain", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--wallpaper", action="store_true")
    group.add_argument("--screensaver", action="store_true")
    group.add_argument("--window", action="store_true")
    group.add_argument("--tty", action="store_true")
    parser.add_argument("--fps", type=int, default=12, help="frames per second (default 12)")
    parser.add_argument("--cell", type=int, default=16, help="glyph size in pixels")
    parser.add_argument("--ring", type=int, default=0,
                        help="thickness of the RGB edge ring (0 = off)")
    args = parser.parse_args()

    if args.tty or not os.environ.get("DISPLAY"):
        return run_tty(args.fps)
    mode = ("wallpaper" if args.wallpaper else
            "screensaver" if args.screensaver else "window")
    return run_gtk(mode, max(4, min(args.fps, 30)), max(6, args.cell), args.ring)


if __name__ == "__main__":
    sys.exit(main())
